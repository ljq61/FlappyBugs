{
  "name": "flappybugs",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:crazygames": "vite build --mode crazygames --outDir dist-crazygames",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check:release": "node scripts/check-release.mjs",
    "package:crazygames": "npm run build:crazygames && npm run check:release -- dist-crazygames && node scripts/package-release.mjs",
    "package:standalone": "npm run build && npm run check:release && node scripts/package-release.mjs standalone"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
